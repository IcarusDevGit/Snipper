{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipper.agent/schemas/findings.schema.json",
  "title": "SnipperFindingsOutput",
  "type": "object",
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "snippet_text"
        ],
        "properties": {
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "question_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "snippet_text": {
            "type": "string",
            "minLength": 1
          },
          "web_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "definition"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "definition": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string"
                }
              }
            },
            "default": []
          }
        },
        "anyOf": [
          {
            "required": [
              "target_ids"
            ]
          },
          {
            "required": [
              "question_numbers"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "unanswered_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "unanswered_questions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "additionalProperties": false
}
