{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snipper.agent/schemas/findings.schema.json",
  "title": "SnipperFindingsOutput",
  "type": "object",
  "required": [
    "findings",
    "unanswered_questions"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_numbers",
          "snippet_text"
        ],
        "properties": {
          "question_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "snippet_text": {
            "type": "string",
            "minLength": 1
          },
          "web_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "default": []
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "additionalProperties": false
      }
    },
    "unanswered_questions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "additionalProperties": false
}
