        <object id="c_4_8" label="&lt;div style=&quot;text-align: center; font-size: 13px; font-weight: bold; color: #5b21b6; margin-bottom: 8px;&quot;&gt;SECURITY &amp; AUDITING&lt;/div&gt;&lt;table style=&quot;width: 100%; border-collapse: collapse; font-size: 11px; text-align: left;&quot; cellpadding=&quot;4&quot;&gt;&lt;thead&gt;&lt;tr style=&quot;background-color: #ede9fe; color: #4c1d95; font-weight: bold; border-bottom: 1px solid #c4b5fd;&quot;&gt;&lt;th style=&quot;padding: 6px 10px; width: 22%;&quot;&gt;Regra&lt;/th&gt;&lt;th style=&quot;padding: 6px 10px; width: 40%;&quot;&gt;Estrutura Lógica&lt;/th&gt;&lt;th style=&quot;padding: 6px 10px; width: 38%;&quot;&gt;Exemplo&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style=&quot;background-color: #ffffff; border-bottom: 1px solid #ede9fe;&quot;&gt;&lt;td style=&quot;padding: 6px 10px; font-weight: bold; color: #5b21b6; vertical-align: top; white-space: nowrap;&quot;&gt;Trusted Sources&lt;/td&gt;&lt;td style=&quot;padding: 6px 10px; color: #1e293b; vertical-align: top;&quot;&gt;Only install skills authored or vetted by trusted creators&lt;/td&gt;&lt;td style=&quot;padding: 6px 10px; color: #475569; font-size: 10px; vertical-align: top;&quot;&gt;Verified internal repos or official skill registries&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: #faf5ff; border-bottom: 1px solid #ede9fe;&quot;&gt;&lt;td style=&quot;padding: 6px 10px; font-weight: bold; color: #5b21b6; vertical-align: top; white-space: nowrap;&quot;&gt;Pre-Use Auditing&lt;/td&gt;&lt;td style=&quot;padding: 6px 10px; color: #1e293b; vertical-align: top;&quot;&gt;Inspect SKILL.md directives, bundled scripts, and dependencies&lt;/td&gt;&lt;td style=&quot;padding: 6px 10px; color: #475569; font-size: 10px; vertical-align: top;&quot;&gt;Review network calls, shell commands, and file writes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: #ffffff; border-bottom: 1px solid #ede9fe;&quot;&gt;&lt;td style=&quot;padding: 6px 10px